# Copy this to .env and fill in real values. .env is gitignored — never commit it.
#
# NODE_ENV is deliberately not set here: leave it unset for local development.
# The Docker image sets NODE_ENV=production itself, which turns on secure cookies,
# trusting the Caddy proxy, and the SESSION_SECRET check below.

PORT=6559

# Base URL the app is served at — used to build links in invite/reset/verify emails.
# Local development: http://localhost:6559. Production: your real https:// domain.
APP_URL=http://localhost:6559

# Long random string used to sign session cookies. In production the app refuses
# to start while this is still "changeme". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme

# Where the SQLite file lives (also mounted as a volume in docker-compose.yml)
DATABASE_PATH=./data/app.db

# Resend (https://resend.com) — free tier covers this app's volume comfortably.
# Leave empty locally: emails aren't sent, and the link they would have contained
# (invite, password reset, email verification) is printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Name <notice@example.com>"
