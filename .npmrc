# Skip dependency install scripts. better-sqlite3 13+ ships prebuilt N-API
# binaries for every platform we run on (Windows, macOS, Linux glibc/musl), but
# npm still triggers an implicit `node-gyp rebuild` for it when installing from
# the lockfile — which needs Visual Studio on Windows and python3/make/g++ in
# Docker, purely to compile nothing. Nothing else in the tree needs its install
# script (esbuild locates its platform binary at runtime).
#
# `npm run <script>`, `npm test` and `npm start` are unaffected. If you ever add
# a dependency that genuinely needs its install script, run `npm rebuild <pkg>`.
ignore-scripts=true
