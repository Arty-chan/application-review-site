{% extends "base.njk" %}
{% block title %}Add a user — {{ siteName }}{% endblock %}
{% block content %}
  <div class="card" style="max-width: 360px;">
    <h1>Add a user</h1>
    <p class="note">The account is ready to use straight away. Share the password with them; they can change it from their account page.</p>
    {% if error %}<p class="error">{{ error }}</p>{% endif %}
    <form method="post" action="/admin/users/new">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <label>Email
        <input class="input" type="email" name="email" value="{{ values.email }}" required autofocus>
      </label>
      <label>Display name
        <input class="input" type="text" name="displayName" value="{{ values.displayName }}" required maxlength="{{ displayNameMaxLength }}">
      </label>
      <label>Password (at least {{ passwordMinLength }} characters)
        <input class="input" type="password" name="password" required minlength="{{ passwordMinLength }}" autocomplete="new-password">
      </label>
      <label>Role
        <select name="role" class="input">
          <option value="user" {% if values.role == 'user' %}selected{% endif %}>user</option>
          <option value="admin" {% if values.role == 'admin' %}selected{% endif %}>admin</option>
        </select>
      </label>
      <button class="btn" type="submit">Add user</button>
    </form>
  </div>
{% endblock %}
