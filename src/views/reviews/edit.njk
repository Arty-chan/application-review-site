{% extends "base.njk" %}
{% import "_macros.njk" as m %}
{% block title %}Edit review — {{ siteName }}{% endblock %}
{% block content %}

<h1>Edit your review of {{ company.name }}</h1>
{% if error %}<p class="error">{{ error }}</p>{% endif %}

<form method="post" action="/companies/{{ company.id }}/reviews/{{ review.id }}" class="card">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  {{ m.reviewVisibilityNote(reviewVisibility) }}
  {{ m.starRatingInput(review.rating) }}
  <label>When did you go through this process?
    <input class="input" type="date" name="jobProcessDate" value="{{ review.jobProcessDate | isoDate }}">
  </label>
  <label>Comment
    <textarea class="input" name="comment" required rows="4">{{ review.comment }}</textarea>
  </label>
  {{ m.reviewReportFields(reviewReports, review) }}
  <button class="btn" type="submit">Save changes</button>
</form>

<form method="post" action="/companies/{{ company.id }}/reviews/{{ review.id }}/delete" data-confirm="Delete this review?">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <button class="btn btn-secondary" type="submit">Delete review</button>
</form>

{% endblock %}
