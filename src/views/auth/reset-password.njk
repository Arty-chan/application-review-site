{% extends "base.njk" %}
{% block title %}{% if needsDisplayName %}Set up your account{% else %}Reset your password{% endif %} — {{ siteName }}{% endblock %}
{% block content %}
  <div class="card" style="max-width: 360px;">
    {% if not valid %}
      <h1>Link expired</h1>
      <p>This link is invalid or has expired.</p>
      <p><a href="/forgot-password">Request a new password reset link</a>.</p>
    {% else %}
      <h1>{% if needsDisplayName %}Set up your account{% else %}Reset your password{% endif %}</h1>
      {% if error %}<p class="error">{{ error }}</p>{% endif %}
      <form method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if needsDisplayName %}
          <label>Display name
            <input class="input" type="text" name="displayName" maxlength="{{ displayNameMaxLength }}" required autofocus>
          </label>
        {% endif %}
        <label>{% if needsDisplayName %}Password{% else %}New password{% endif %}
          <input class="input" type="password" name="password" minlength="{{ passwordMinLength }}" required {% if not needsDisplayName %}autofocus{% endif %}>
        </label>
        <button class="btn" type="submit">{% if needsDisplayName %}Activate account{% else %}Reset password{% endif %}</button>
      </form>
    {% endif %}
  </div>
{% endblock %}
