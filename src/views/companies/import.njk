{% extends "base.njk" %}
{% block title %}Import — {{ siteName }}{% endblock %}
{% block content %}

<h1>Import</h1>

{% if csvImport.results %}
  <p>Added {{ csvImport.results | selectattr('ok') | length }} of {{ csvImport.results.length }}.</p>
  <ul>
    {% for result in csvImport.results %}
      <li>
        {% if result.ok %}
          <a href="/companies/{{ result.id }}">{{ result.name }}</a> — added
        {% else %}
          {{ result.name }} — <span class="error">{{ result.error }}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  <p><a href="/import">Import more</a></p>
{% else %}
  <p>
    Add companies in bulk. Paste CSV below: a header row naming the columns, then
    one company per row. Only <code>name</code> and <code>websiteUrl</code> are
    required — leave out any other column, or leave its cells blank. Columns can
    be in any order.
  </p>

  <table>
    <thead><tr><th>Column</th><th>Accepts</th></tr></thead>
    <tbody>
      {% for column in csvColumns %}
        <tr><td><code>{{ column.name }}</code></td><td>{{ column.description }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <p>Every column, ready to copy as a header row:</p>
  <pre>{{ headerRow }}</pre>

  <p>For example — a value containing a comma needs double quotes around it:</p>
  <pre>name,websiteUrl,location,industry,hiresRemote
Acme,acme.com,Germany,Software &amp; Technology,yes
"Globex, Inc.",globex.com,EMEA,,no</pre>

  {% if csvImport.error %}<p class="error">{{ csvImport.error }}</p>{% endif %}
  <form method="post" action="/import" class="card">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <label>CSV
      <textarea class="input" name="csv" rows="12" required>{{ csvImport.csv }}</textarea>
    </label>
    <button class="btn" type="submit">Import</button>
  </form>
{% endif %}

{% if currentUser.role == 'admin' %}
  <h2>Export</h2>
  <p>
    Download every company as a CSV file, in the columns above. Location and
    industry list all of a company's countries and industries, separated by
    commas.
  </p>
  <a class="btn btn-secondary" href="/import/export.csv">Export companies as CSV</a>
{% endif %}

{% endblock %}
