{% extends "base.njk" %}
{% block title %}Favourites — {{ siteName }}{% endblock %}
{% block content %}

<h1>Favourites</h1>

{% if companies.length == 0 %}
  <p>You haven't favourited any companies yet.</p>
{% endif %}

{% for company in companies %}
  <div class="card">
    <a href="/companies/{{ company.id }}">{{ company.name }}</a>
  </div>
{% endfor %}

{% endblock %}
